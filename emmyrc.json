{
    "diagnostics": {
        "severity": {
            "unused": "hint",
            "undefined-field": "information",
            "redundant-return": "hint",
            "redundant-return-value": "hint",
            "param-type-mismatch": "information",
            "missing-fields": "information",
            "assign-type-mismatch": "information",
            "return-type-mismatch": "information",
            "missing-parameter": "information",
            "cast-type-mismatch": "information"
        },

        "disable": [
            "duplicate-set-field",
            "duplicate-type",
            "inject-field",
            "unnecessary-if",
            "need-check-nil"
        ],

        "diagnosticInterval": 1000
    },

    "completion": {
        "callSnippet": false,
        "stagedCallSnippets": true
    },

    "runtime": {
        "nonstandardSymbol": [
        ],
        "requireLikeFunction": [
            "include"
        ],
        "version": "LuaJIT"
    },

    "hint": {
        "paramHint": false
    },

    "lint": {
        "spellCheck": false
    }
}
